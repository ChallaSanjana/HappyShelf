{
  "name": "happyshelf-backend",
  "version": "1.0.0",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "test": "cross-env NODE_ENV=test ML_SERVICE_URL=http://127.0.0.1:1 node --test \"__tests__/**/*.test.js\"",
    "test:watch": "cross-env NODE_ENV=test ML_SERVICE_URL=http://127.0.0.1:1 node --test --watch \"__tests__/**/*.test.js\""
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.22.2",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.9.1",
    "nodemailer": "^9.0.3"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "supertest": "^7.2.2"
  }
}
