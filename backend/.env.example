PORT=5000
MONGODB_URI=mongodb://localhost:27017/happyshelf

# REQUIRED in production — the server refuses to start without it there.
# In development an insecure default is used if this is unset.
JWT_SECRET=your_jwt_secret_here_change_in_production

# Comma-separated list of browser origins allowed to call this API.
# Defaults to the local dev origins when unset. Set this to your deployed
# frontend's URL in production — a wildcard would let any site make
# credentialed requests on a logged-in user's behalf.
CORS_ORIGIN=http://localhost:5173

# Number of reverse-proxy hops in front of this app. Set to "false" to stop
# trusting X-Forwarded-For entirely (only correct when nothing proxies you).
# TRUST_PROXY=1

# ML prediction service. The backend proxies to this and silently falls back
# to a JS heuristic if it's unreachable or slow, so it's optional locally.
# ML_SERVICE_TOKEN must match the value set on the ML service itself; leave
# both unset only when the service is bound to loopback.
ML_SERVICE_URL=http://127.0.0.1:8000
ML_SERVICE_TOKEN=
ML_SERVICE_TIMEOUT_MS=5000

# Public URL of the frontend, used to build the link in password-reset
# emails. Getting this wrong doesn't fail loudly — it just emails people a
# link pointing at localhost, so set it for any deployment.
APP_URL=http://localhost:5173

# How long a password-reset link stays valid. Short on purpose.
PASSWORD_RESET_TTL_MINUTES=30

# Email notifications (low/out-of-stock alerts, password-reset links). If any
# of these are unset, emails are logged to the console instead of sent — the
# app still works, it just won't deliver real mail. Never contacted at all
# under NODE_ENV=test or test-e2e.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_smtp_password_or_app_password
EMAIL_FROM=HappyShelf <your_email@gmail.com>
